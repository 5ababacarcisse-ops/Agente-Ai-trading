# Public data and paper trading work without Binance credentials.
# Never put real secrets in this file or commit a real .env.
TRADING_MODE=paper
TRADING_SYMBOL=BTCUSDT
TRADING_INTERVAL=1h
TRADING_CANDLES=300
FAST_WINDOW=10
SLOW_WINDOW=30
MAX_ALLOCATION_FRACTION=0.10
MAX_DAILY_LOSS_FRACTION=0.01
FEE_FRACTION=0.001
SLIPPAGE_FRACTION=0.0005
POLL_SECONDS=60

# Live trading is intentionally disabled by default.
# Only after reviewing/testing all code, set the following in a secure runtime:
# TRADING_MODE=live
# LIVE_TRADING_ENABLED=true
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_REAL_MONEY_RISK
# BINANCE_API_KEY=...
# BINANCE_API_SECRET=...
# Binance API key must have Spot trading only; disable withdrawals and restrict IPs.
